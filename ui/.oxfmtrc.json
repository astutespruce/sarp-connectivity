{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "none",
	"semi": false,
	"printWidth": 100,
	"tabWidth": 2,
	"sortPackageJson": false,
	"ignorePatterns": [
		"package-lock.json",
		"pnpm-lock.yaml",
		"yarn.lock",
		"bun.lock",
		"bun.lockb",
		"data/*.json"
	],
	"sortImports": {
		"newlinesBetween": false,
		"customGroups": [
			{
				"groupName": "sveltekit-app",
				"elementNamePattern": ["$app/**/*"]
			},
			{
				"groupName": "svelte-content",
				"elementNamePattern": ["$content/**/*"]
			},
			{
				"groupName": "svelte-images",
				"elementNamePattern": ["#images/**/*"]
			},
			{
				"groupName": "svelte-lib",
				"elementNamePattern": ["#lib/**/*"],
				"modifiers": ["value"]
			},
			{
				"groupName": "type-svelte-lib",
				"elementNamePattern": ["#lib/**/*"],
				"modifiers": ["type"]
			}
		],
		"groups": [
			"value-builtin",
			"value-external",
			{ "newlinesBetween": true },
			"sveltekit-app",
			"svelte-content",
			"svelte-images",
			"svelte-lib",
			["value-internal", "value-parent", "value-sibling", "value-index"],
			{ "newlinesBetween": true },
			"type-import",
			"type-svelte-lib",
			"unknown"
		]
	}
}
