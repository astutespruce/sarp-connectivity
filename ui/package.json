{
	"name": "sarp-prioritization-tool",
	"description": "National Aquatic Barrier Inventory & Prioritization Tool",
	"version": "4.3.0",
	"date": "7/30/2026",
	"author": "Brendan C. Ward <bcward@astutespruce.com>",
	"license": "MIT",
	"private": false,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "oxfmt .",
		"lint": "oxfmt --check . && oxlint && eslint .",
		"knip": "knip",
		"predeploy": "npm run build",
		"deploy": "rm -rf /var/www/sarp-connectivity/* && cp -r public/* /var/www/sarp-connectivity"
	},
	"imports": {
		"#lib/*": "./src/lib/*",
		"#content/*": "./src/content/*",
		"#data/*": "./data/*",
		"#icons/*": "./src/lib/assets/icons/*",
		"#images/*": "./src/lib/assets/images/*"
	},
	"dependencies": {
		"@placemarkio/geo-viewport": "^1.0.2",
		"@sentry/svelte": "^11.6.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/enhanced-img": "^1.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/svelte-query": "^6.3.1",
		"@types/node": "^26",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@uwdata/flechette": "^2.6.0",
		"arquero": "^8.0.3",
		"camelcase-keys": "^10.0.3",
		"clsx": "^2.1.1",
		"dequal": "^2.0.3",
		"dotenv": "^18.0.7",
		"formsnap": "^2.0.1",
		"globals": "^17.13.0",
		"mapbox-gl": "3.32",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"sveltekit-superforms": "^3.0.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"uuid": "^14.0.2",
		"vite": "^8.3.4",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.54.0",
		"@sveltejs/load-config": "^0.2.3",
		"bits-ui": "^2.19.5",
		"eslint": "^10.12.0",
		"eslint-plugin-oxlint": "^1.87.0",
		"eslint-plugin-svelte": "^3.23.1",
		"knip": "^6.41.0",
		"oxfmt": "^0.72.0",
		"oxlint": "^1.87.0",
		"send": "^1.2.1",
		"typescript-eslint": "^8.71.1"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/astutespruce/sarp-connectivity"
	},
	"bugs": {
		"url": "https://github.com/astutespruce/sarp-connectivity/issues"
	}
}
